DATABASE_URL="postgresql://ops_readonly.fpynisjwugworsctojie:<PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require"
# Separate role limited to adapter monitoring/staging tables. It cannot edit canonical races or user entries.
ADAPTER_OPS_DATABASE_URL="postgresql://ops_monitoring.fpynisjwugworsctojie:<PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require"
# Only if your local network injects a self-signed certificate and pg fails with SELF_SIGNED_CERT_IN_CHAIN:
# PG_REJECT_UNAUTHORIZED=false

# Same production Clerk instance used by https://wone.one. Never commit live values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace-me
CLERK_SECRET_KEY=sk_live_replace-me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/ops

# Use the canonical host so a redirect cannot strip the Authorization header.
MAIN_APP_URL=https://www.wone.one

# Vercel sends this as `Authorization: Bearer <CRON_SECRET>` to cron routes.
CRON_SECRET=replace-with-a-random-secret

# Hosted Python adapter service operation endpoints.
ADAPTER_DISCOVERY_URL=https://your-adapter-service.example.com/operations/discover-events
ADAPTER_STRESS_URL=https://your-adapter-service.example.com/operations/stress
ADAPTER_SERVICE_TOKEN=replace-with-the-adapter-service-token
